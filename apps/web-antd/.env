# 应用标题
VITE_APP_TITLE=Vue3 Java17 Admin

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=vue3-java17-admin

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密。
# 注意：该值会被打进前端产物（VITE_ 前缀），因此它不是"服务端秘密"，
# 作用是避免沿用模板默认值、并隔离同域名下的多套系统。
# 轮换它会让浏览器里已加密的旧数据无法解密（使用者需清一次缓存并重新登录）。
VITE_APP_STORE_SECURE_KEY=CI3RyONYtM78pwmHkgMNL9v7jv9S6fnj
