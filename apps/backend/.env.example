# ============================================================
# 后端环境变量样例
#
# 用法：Spring Boot 不会自动读取 .env 文件，请按需注入：
#   · 本地/脚本：set -a; source .env; set +a; ./mvnw spring-boot:run
#   · Docker：   docker run --env-file .env ...
#   · 容器平台： 把下面的键值填进对应的 Secret / ConfigMap
#
# 未设置的项会回落到 application.yaml 中的「本地开发默认值」；
# 生产环境必须激活 prod profile（见 application-prod.yaml 与 StartupChecks 告警）。
# ============================================================

# ---------- 运行 profile ----------
# ⚠️ 生产必须显式设为 prod：关闭种子账号、关闭接口文档、强制 Cookie Secure、收敛 CORS，
#    并开启下方的严格模式（配置违规时直接拒绝启动）。
#    后端 Dockerfile 已内置该变量；java -jar / 裸机 / K8s 手写 Deployment 务必自行注入。
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库（MySQL 8） ----------
# createDatabaseIfNotExist=true 仅适用于开发；生产建议由 DBA 预先建库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yorvix
# ⚠️ prod profile 下这三个变量的默认值是 DB_HOST_NOT_SET / DB_USERNAME_NOT_SET /
#    DB_PASSWORD_NOT_SET 这类哨兵串：缺失时会在错误信息里直接显示该哨兵值
#    （不会再悄悄回落到 root/root），据此可立即定位是哪个变量没注入。
#    生产请使用最小权限账号，不要用 root。
DB_USERNAME=root
DB_PASSWORD=root
# 生产连接 TLS：prod 默认 REQUIRED（连接必须加密）。
# 目标库尚未配置证书时临时设 DISABLED，并同时打开公钥检索（MySQL 8 的
# caching_sha2_password 在非加密通道下需要它），随后尽快补上证书。
DB_SSL_MODE=REQUIRED
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# ---------- Redis ----------
# 令牌（access / refresh）全部存在 Redis，必须可达，否则登录即失败
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 令牌有效期（分钟） ----------
TOKEN_EXPIRE_MINUTES=120
TOKEN_REFRESH_EXPIRE_MINUTES=10080

# ---------- CORS ----------
# 逗号分隔的受信来源。留空 = 不注册 CORS（只允许同源请求，生产推荐形态）。
# 不要使用 *：后端 allowCredentials=true，通配符等于放行任何站点携带凭证跨域请求。
CORS_ALLOWED_ORIGINS=

# ---------- refresh Cookie ----------
# HTTPS 环境必须为 true，否则 refresh Cookie 可能经明文请求发出（prod profile 已强制 true）
COOKIE_SECURE=false

# ---------- 种子数据（仅首次启动、仅开发） ----------
# 生产必须 SEED_ENABLED=false，否则连上全新库会立刻出现一个 admin/弱口令的超管账号
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=123456

# ---------- 启动自检 ----------
# true（默认）：启动时把实体定义与实际表结构比对，缺表/缺列直接拒绝启动并打印迁移指引。
# 典型触发场景是"改了实体但没写新的迁移文件（V2__xxx.sql）"，
# 除非有明确理由，不要关闭。
VERIFY_SCHEMA=true

# ---------- 严格模式 ----------
# prod profile 默认 true：种子账号开启 / CORS 含 * / Cookie 未启用 Secure 三项中
# 任一违规时**拒绝启动**（而不是只打一行告警）。本地开发默认 false，仅告警、不影响启动。
SECURITY_STRICT_MODE=true

# ---------- 登录限流 ----------
# 同一账号或同一 IP 的连续登录失败上限；达到后拒绝登录（HTTP 200 + 业务码 1010）。
# 不限流等于把 CPU（PBKDF2 十万次迭代）与数据库连接交给攻击者，生产不要调得过大。
LOGIN_MAX_ATTEMPTS=5
# 被锁定后的时长（分钟）
LOGIN_LOCK_MINUTES=15
# 取真实客户端 IP 的请求头名（如 Nginx 的 X-Real-IP）。留空 = 用 remoteAddr。
# ⚠️ 只有应用确实位于【可信反向代理】之后才可以配置：该请求头是调用方可控输入，
#    直连暴露时配置它，等于让请求方自己指定限流键，按 IP 的限流形同虚设。
#    取值规则见 security/ClientInfoResolver（取逗号分隔的最后一项）。
CLIENT_IP_HEADER=

# ---------- 菜单 ----------
# 登录后的全局统一首页；留空 = 自动取该用户第一个可访问页面
MENU_HOME_PATH=
# ADMIN 独占菜单的路由地址前缀（逗号分隔）：不参与 RBAC 授权。
# 新增 ADMIN 独占的顶级菜单时必须追加，否则会出现“能勾选授权、一访问接口就 403”。
MENU_ADMIN_ONLY_PATHS=/system
